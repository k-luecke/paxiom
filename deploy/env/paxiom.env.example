NODE_ENV=production

# UI. Keep the app bound to localhost; Nginx/Caddy owns public HTTP(S).
PAXIOM_UI_HOST=127.0.0.1
PAXIOM_UI_PORT=3000

# Private operator access. Comma-separate addresses if you add more operators.
PAXIOM_ALLOWED_WALLETS=0xYourMetaMaskAddress

# Internal service bind addresses.
SERVICE_CATALOG_HOST=127.0.0.1
SERVICE_CATALOG_PORT=8090
SYNC_COMMITTEE_HOST=127.0.0.1
SYNC_COMMITTEE_PORT=8080
LOAD_NETWORK_SERVICE_HOST=127.0.0.1
LOAD_NETWORK_SERVICE_PORT=8081
ARB_ENGINE_HOST=127.0.0.1
ARB_ENGINE_PORT=8082
COMPLIANCE_SERVICE_HOST=127.0.0.1
COMPLIANCE_SERVICE_PORT=8083
SLOT_STORAGE_PROOF_HOST=127.0.0.1
SLOT_STORAGE_PROOF_PORT=8091
CROSS_CHAIN_MESSAGE_HOST=127.0.0.1
CROSS_CHAIN_MESSAGE_PORT=8093
SIMULATION_SERVICE_HOST=127.0.0.1
SIMULATION_SERVICE_PORT=8094
HISTORICAL_STATE_HOST=127.0.0.1
HISTORICAL_STATE_PORT=8095

# Development defaults. Tighten these before public paid access.
MOCK_LOAD_NETWORK=1
MOCK_SYNC_COMMITTEE=1
REQUIRE_X402=0

# Fill these when moving beyond private reference mode.
# PAXIOM_RESPONSE_SIGNING_PRIVATE_KEY_PEM=
# X402_FACILITATOR_URL=
# LOAD_NETWORK_API_URL=
# LOAD_NETWORK_API_KEY=
# COMPLIANCE_LOG_FILE=/var/lib/paxiom/compliance-events.ndjson
