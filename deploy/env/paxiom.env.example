NODE_ENV=production
PAXIOM_DEPLOYMENT_MODE=testnet

# UI. Keep the app bound to localhost; Nginx/Caddy owns public HTTP(S).
PAXIOM_UI_HOST=127.0.0.1
PAXIOM_UI_PORT=3000

# Private operator access. REQUIRED: UI refuses to start if no entry matches
# /^0x[0-9a-f]{40}$/. Comma-separate to add more operators.
PAXIOM_ALLOWED_WALLETS=

# Internal service bind addresses.
SERVICE_CATALOG_HOST=127.0.0.1
SERVICE_CATALOG_PORT=8090
SYNC_COMMITTEE_HOST=127.0.0.1
SYNC_COMMITTEE_PORT=8080
LOAD_NETWORK_SERVICE_HOST=127.0.0.1
LOAD_NETWORK_SERVICE_PORT=8081
ARB_ENGINE_HOST=127.0.0.1
ARB_ENGINE_PORT=8082
COMPLIANCE_SERVICE_HOST=127.0.0.1
COMPLIANCE_SERVICE_PORT=8083
SLOT_STORAGE_PROOF_HOST=127.0.0.1
SLOT_STORAGE_PROOF_PORT=8091
CROSS_CHAIN_MESSAGE_HOST=127.0.0.1
CROSS_CHAIN_MESSAGE_PORT=8093
SIMULATION_SERVICE_HOST=127.0.0.1
SIMULATION_SERVICE_PORT=8094
HISTORICAL_STATE_HOST=127.0.0.1
HISTORICAL_STATE_PORT=8095

# Testnet defaults. Mocks are forbidden by the service preflight in
# PAXIOM_DEPLOYMENT_MODE=testnet|staging|production.
MOCK_LOAD_NETWORK=0
MOCK_DEVICE=0
MOCK_SYNC_COMMITTEE=0

# Private testnet proof can run with REQUIRE_X402=0; response payment metadata
# will say verified:false and settled:false. Public paid access should set
# REQUIRE_X402=1 plus X402_FACILITATOR_URL and a non-zero X402_DESTINATION.
REQUIRE_X402=0

# Acknowledgment for dev/CI. Uncomment alongside MOCK_DEVICE=1 in non-prod.
# PAXIOM_ALLOW_MOCK=1

# Fill these when moving beyond private reference mode.
# PAXIOM_RESPONSE_SIGNING_PRIVATE_KEY_PEM=
# PAXIOM_RESPONSE_SIGNING_KEY_ID=paxiom-testnet-response-key-001
# X402_FACILITATOR_URL=
# X402_DESTINATION=0xYourSettlementAddress
# LOAD_NETWORK_URL=https://load.network
# LOAD_NETWORK_API_KEY=

# A-201/A-205 proof archive. In testnet/staging/production, strict preflight
# requires local or arweave plus an encryption key. Generate a key with:
#   openssl rand -base64 32
# PAXIOM_PROOF_ARCHIVE_MODE=local
# PAXIOM_PROOF_ARCHIVE_DIR=/var/lib/paxiom/proof-archive
# PAXIOM_PROOF_ARCHIVE_WAREHOUSE=operator-local
# PAXIOM_PROOF_ARCHIVE_STORAGE_CLASS=hot-local
# PAXIOM_PROOF_ARCHIVE_LATENCY_CLASS=synchronous
# PAXIOM_PROOF_ARCHIVE_ENCRYPTION_KEY_BASE64=
# PAXIOM_PROOF_ARCHIVE_KEY_ID=paxiom-proof-archive-key-001
# PAXIOM_ARWEAVE_WALLET_JWK_PATH=/var/lib/paxiom/arweave-wallet.json
# PAXIOM_AO_PROOF_ARCHIVE_PROCESS=

# BLS_DEVICE_VIA_SUBPROCESS=1
# BLS_DEVICE_HARNESS=/usr/local/bin/bls-device-harness
# COMPLIANCE_LOG_FILE=/var/lib/paxiom/compliance-events.ndjson
