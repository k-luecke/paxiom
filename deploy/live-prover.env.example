# Copy this to /etc/paxiom/live-prover.env on the prover host.

ETH_RPC_URL=https://ethereum-rpc.publicnode.com
PAXIOM_LIVE_BLOCK_TAG=finalized
PAXIOM_LIVE_POLL_MS=12000
PAXIOM_WRITE_FEED=true
PAXIOM_FEED_FILE=/var/lib/paxiom/feed-items.jsonl

# First subscriber-ready package: Uniswap V3 USDC/WETH 0.05% slot0.
PAXIOM_WATCH_KIND=uniswap-v3-slot0
PAXIOM_WATCH_ADDRESS=0x88e6A0c2dDD26FEEb64F039a2c41296FcB3f5640
PAXIOM_TOKEN0_DECIMALS=6
PAXIOM_TOKEN1_DECIMALS=18

# Optional AO commitment.
# PAXIOM_PROOF_CORPUS_PROCESS=
# AR_WALLET=/etc/paxiom/arweave-wallet.json
