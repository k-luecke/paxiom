# Copy this to /etc/paxiom/feed-api.env on the API host.

# Public API listener. Put nginx/Caddy in front for HTTPS.
PAXIOM_FEED_BIND=127.0.0.1
PAXIOM_FEED_PORT=7071
PAXIOM_FEED_ALLOWED_ORIGIN=https://paxiom.org

# Keep production feed data subscriber-gated.
PAXIOM_FEED_PUBLIC_READ=false
PAXIOM_FEED_RATE_LIMIT_PER_MIN=120

# Shared append-only feed item file written by the live prover.
PAXIOM_FEED_FILE=/var/lib/paxiom/feed-items.jsonl

# Subscriber config.
# Generate hashes with:
#   npm run feed:hash-token -- <plain-token>
#
# Single-token bootstrap:
# PAXIOM_FEED_TOKEN=<plain-token>
#
# Multi-subscriber JSON file:
PAXIOM_FEED_SUBSCRIBERS_FILE=/etc/paxiom/subscribers.json
