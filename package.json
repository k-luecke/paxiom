{
  "name": "paxiom",
  "version": "1.0.0",
  "description": "Paxiom phase-1 services + legacy operator pipeline.",
  "license": "MIT",
  "author": "k-luecke",
  "repository": {
    "type": "git",
    "url": "https://github.com/k-luecke/paxiom.git"
  },
  "main": "index.js",
  "scripts": {
    "test": "npm run test:sync-committee && npm run test:load-network && npm run test:services && npm run test:ui && npm run test:core && npm run test:local-verifier",
    "test:core": "node core/test.js",
    "test:sync-committee": "node --test services/sync-committee/test/server.test.mjs",
    "test:load-network": "node --test load-network/test/verifier.test.mjs load-network/test/reconstruct.test.mjs load-network/test/live.test.mjs",
    "test:services": "node --test services/shared/test/x402.test.mjs services/catalog/test/server.test.mjs services/load-network/test/server.test.mjs services/slot-storage-proof/test/server.test.mjs services/historical-state/test/server.test.mjs services/cross-chain-message/test/server.test.mjs services/simulation/test/server.test.mjs services/arb-engine/test/server.test.mjs services/compliance/test/server.test.mjs",
    "test:ui": "node --test ui/test/server.test.mjs",
    "test:local-verifier": "node --test services/local-verifier/test/server.test.mjs services/local-verifier/test/signature.test.mjs services/local-verifier/test/fixture.test.mjs services/local-verifier/test/ethereum-header.test.mjs services/local-verifier/test/ethereum-mpt.test.mjs",
    "dev": "node services/local-verifier/server.mjs",
    "hyperbeam:install": "./hyperbeam/bringup/install.sh",
    "hyperbeam:shell": "./hyperbeam/bringup/shell.sh",
    "hyperbeam:smoke": "./hyperbeam/bringup/smoke-test.sh",
    "service:sync-committee": "node services/sync-committee/server.mjs",
    "service:catalog": "node services/catalog/server.mjs",
    "service:slot-storage-proof": "node services/slot-storage-proof/server.mjs",
    "service:cross-chain-message": "node services/cross-chain-message/server.mjs",
    "service:simulation": "node services/simulation/server.mjs",
    "service:historical-state": "node services/historical-state/server.mjs",
    "service:load-network": "node services/load-network/server.mjs",
    "service:arb-engine": "node services/arb-engine/server.mjs",
    "service:compliance": "node services/compliance/server.mjs",
    "service:local-verifier": "node services/local-verifier/server.mjs",
    "service:ui": "node ui/server.js",
    "verify:demo": "node services/local-verifier/scripts/verify-demo.mjs",
    "verify:signature-demo": "node services/local-verifier/scripts/verify-signature-demo.mjs",
    "verify:fixture-demo": "node services/local-verifier/scripts/verify-fixture-demo.mjs",
    "verify:ethereum-header-demo": "node services/local-verifier/scripts/verify-ethereum-header-demo.mjs",
    "verify:ethereum-mpt-demo": "node services/local-verifier/scripts/verify-ethereum-mpt-demo.mjs",
    "replay": "node services/local-verifier/scripts/replay.mjs"
  },
  "keywords": ["paxiom", "ao", "hyperbeam", "ethereum", "arweave"],
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ethereumjs/rlp": "10.1.1",
    "@ethereumjs/trie": "6.2.1",
    "@ethereumjs/util": "10.1.1",
    "@permaweb/aoconnect": "0.0.93",
    "viem": "2.47.5"
  }
}
