{
  "name": "paxiom",
  "version": "1.0.0",
  "description": "Paxiom phase-1 services + legacy operator pipeline.",
  "license": "MIT",
  "author": "k-luecke",
  "repository": {
    "type": "git",
    "url": "https://github.com/k-luecke/paxiom.git"
  },
  "main": "index.js",
  "scripts": {
    "test": "npm run test:sync-committee && npm run test:load-network && npm run test:services && npm run test:sdk && npm run test:ui && npm run test:core",
    "test:core": "node core/test.js",
    "test:sync-committee": "node --test services/sync-committee/test/server.test.mjs",
    "test:load-network": "node --test load-network/test/verifier.test.mjs load-network/test/reconstruct.test.mjs load-network/test/erigon-client.test.mjs load-network/test/live.test.mjs",
    "test:services": "node --test services/shared/test/config-store.test.mjs services/shared/test/x402-config.test.mjs services/shared/test/x402.test.mjs services/shared/test/readiness.test.mjs services/shared/test/proof-archive.test.mjs services/catalog/test/server.test.mjs services/load-network/test/server.test.mjs services/slot-storage-proof/test/server.test.mjs services/historical-state/test/server.test.mjs services/cross-chain-message/test/server.test.mjs services/simulation/test/server.test.mjs services/arb-engine/test/server.test.mjs services/arb-runner/test/server.test.mjs services/compliance/test/server.test.mjs",
    "test:sdk": "node --test sdk/test/signal-hmac.test.mjs",
    "test:config-store": "node --test services/shared/test/config-store.test.mjs services/shared/test/x402-config.test.mjs services/shared/test/x402.test.mjs",
    "test:ui": "node --test ui/test/server.test.mjs",
    "proof-archive:verify": "node scripts/proof-archive-verify.mjs",
    "erigon:proof-smoke": "node scripts/probe-erigon-proof-source.mjs",
    "foundation:verify-state": "node load-network/reconstruct-real.mjs",
    "readiness:production": "bash scripts/production-readiness-check.sh",
    "hyperbeam:install": "./hyperbeam/bringup/install.sh",
    "hyperbeam:shell": "./hyperbeam/bringup/shell.sh",
    "hyperbeam:smoke": "./hyperbeam/bringup/smoke-test.sh",
    "service:sync-committee": "node services/sync-committee/server.mjs",
    "service:catalog": "node services/catalog/server.mjs",
    "service:slot-storage-proof": "node services/slot-storage-proof/server.mjs",
    "service:cross-chain-message": "node services/cross-chain-message/server.mjs",
    "service:simulation": "node services/simulation/server.mjs",
    "service:historical-state": "node services/historical-state/server.mjs",
    "service:load-network": "node services/load-network/server.mjs",
    "service:arb-engine": "node services/arb-engine/server.mjs",
    "service:price-scanner": "node services/price-scanner/server.mjs",
    "service:unwind-monitor": "node services/unwind-monitor/server.mjs",
    "service:arb-runner": "node services/arb-runner/server.mjs",
    "service:compliance": "node services/compliance/server.mjs",
    "service:ui": "node ui/server.js"
  },
  "keywords": ["paxiom", "ao", "hyperbeam", "ethereum", "arweave"],
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ethereumjs/rlp": "10.1.1",
    "@ethereumjs/trie": "6.2.1",
    "@ethereumjs/util": "10.1.1",
    "@permaweb/aoconnect": "0.0.93",
    "viem": "2.47.5"
  }
}
